# ==============================================================================
# Dockerfile for Hugging Face Spaces Deployment (Vietnamese Legal RAG)
# ==============================================================================
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    STREAMLIT_SERVER_PORT=7860 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_FILE_WATCHER_TYPE=none

# Install basic Linux dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (Hugging Face Spaces standard UID 1000)
RUN useradd -m -u 1000 user
WORKDIR /app

# Install lightweight CPU-optimized PyTorch
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install application dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code, configurations, data, and indices
COPY --chown=user:user src/ /app/src/
COPY --chown=user:user configs/ /app/configs/
COPY --chown=user:user data/processed/legal_retrieval/corpus_articles_preprocessed.parquet /app/data/processed/legal_retrieval/
COPY --chown=user:user data/indices/bm25_index.pkl /app/data/indices/
COPY --chown=user:user data/indices/dense_bge_m3/ /app/data/indices/dense_bge_m3/
COPY --chown=user:user app.py /app/app.py

# Switch to non-root user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH

EXPOSE 7860

# Run Streamlit Web Application
CMD ["streamlit", "run", "app.py", "--server.port=7860", "--server.address=0.0.0.0"]

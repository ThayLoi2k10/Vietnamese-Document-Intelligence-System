# Python runtime & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
conda/

# Jupyter Notebooks
.ipynb_checkpoints/

# Streamlit secrets & local config
.streamlit/secrets.toml

# Environment variables & secrets
.env
.env.*
!.env.example

# OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Binary executables & native libraries
*.exe
*.dll
*.so
*.dylib

# Model checkpoints & heavy array caches (> 95MB)
*.npy
*.npz
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.gguf
*.tar.gz
*.zip
*.7z

# Large experimental data, benchmarks & outputs
data/*
artifacts/*
results/*

# Explicitly whitelist ONLY the lightweight pre-built serving index & corpus (< 50MB)
!data/indices/
data/indices/*
!data/indices/bm25_index.pkl

!data/processed/
data/processed/*
!data/processed/legal_retrieval/
data/processed/legal_retrieval/*
!data/processed/legal_retrieval/corpus_articles_preprocessed.parquet

# Log & temporary files
*.log
*.tmp
tmp*/
